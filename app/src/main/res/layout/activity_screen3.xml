<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F8F9FA"
    tools:context=".Screen3Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="Club Events"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#132257" />

        <EditText
            android:id="@+id/etEventName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event Name"
            android:inputType="textCapWords"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEventAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount in £ Millions"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgEventType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revenue +"
                android:checked="true"
                android:textColor="#132257"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expense -"
                android:textColor="#132257" />
        </RadioGroup>

        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Event"
            android:backgroundTint="#132257"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Events List"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#132257"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/containerEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
